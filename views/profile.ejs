<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мій профіль - Вузлик до вузлика</title>
    <meta name="description" content="Керування вашим профілем та історія замовлень у майстерні Вузлик до вузлика.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" href="/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preload" href="/fonts/roboto-v47-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-v29-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin>

    <% if (locals.isProduction && locals.gaMeasurementId) { %>
        <script async src="https://www.googletagmanager.com/gtag/js?id=<%= locals.gaMeasurementId %>"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'AW-17036727455');
          gtag('config', '<%= locals.gaMeasurementId %>');
        </script>
    <% } %>

    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" integrity="sha512-xh6O/CkQoPOWDdYTDqeRdPCVd1SpvCA9XXcUnZS2FmJNp1coAFzvtCN9BmamE+4aHK8yyUHUSCcJHgXloTyT2A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <%- include('partials/header') %>

    <main class="profile-section section-padding">
        <div class="container">
            <div class="text-center">
                <span class="section-eyebrow">Особистий кабінет</span>
                <h1 class="section-title">Мій Профіль</h1>
            </div>

            <% if (typeof query !== 'undefined' && query.success) { %>
                <div class="alert alert-success" role="alert">
                    <%= query.success %>
                </div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= query.error %>
                </div>
            <% } %>

            <section class="profile-edit-section">
                <h2>Налаштування профілю</h2>
                <div class="profile-forms-grid">

                    <form action="/profile/update?_method=PUT" method="POST" class="profile-form">
                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <input type="hidden" name="_method" value="PUT">
                        <h3><i class="fa-regular fa-user"></i> Особисті дані</h3>
                        <div class="form-group">
                            <label for="name">Ваше ім'я</label>
                            <input type="text" id="name" name="name" class="form-control" value="<%= user.name || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="email_display">Email (не змінюється)</label>
                            <input type="email" id="email_display" class="form-control" value="<%= user.email %>" disabled readonly>
                        </div>
                        <button type="submit" class="btn btn-primary">Зберегти Ім'я</button>
                    </form>

                    <form action="/profile/change-password" method="POST" class="profile-form">
                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <h3><i class="fa-solid fa-lock"></i> Безпека та пароль</h3>
                        <% if (user.googleId) { %>
                            <div class="google-auth-notice">
                                <i class="fa-brands fa-google"></i>
                                <p>Ви авторизовані через обліковий запис Google. Пароль керується вашим Google-акаунтом.</p>
                            </div>
                        <% } else { %>
                            <div class="form-group">
                                <label for="currentPassword">Поточний пароль <span class="required">*</span></label>
                                <input type="password" id="currentPassword" name="currentPassword" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="newPassword">Новий пароль <span class="required">*</span></label>
                                <input type="password" id="newPassword" name="newPassword" class="form-control" required minlength="5">
                            </div>
                            <div class="form-group">
                                <label for="confirmNewPassword">Підтвердіть новий пароль <span class="required">*</span></label>
                                <input type="password" id="confirmNewPassword" name="confirmNewPassword" class="form-control" required>
                            </div>
                            <button type="submit" class="btn btn-primary">Оновити Пароль</button>
                        <% } %>
                    </form>
                </div>
            </section>

            <section class="order-history">
                <h2>Історія Замовлень</h2>
                <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                    <div class="order-list">
                        <% orders.forEach(order => { %>
                            <div class="order-history-item">
                                <div class="order-summary">
                                    <div>
                                        <strong>Номер замовлення</strong>
                                        <span class="order-num">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                                    </div>
                                    <div>
                                        <strong>Дата оформлення</strong>
                                        <time datetime="<%= order.createdAt.toISOString().split('T')[0] %>"><%= new Date(order.createdAt).toLocaleDateString('uk-UA') %></time>
                                    </div>
                                    <div>
                                        <strong>Сума замовлення</strong>
                                        <span class="order-sum"><%= formatPrice(order.totalAmount, selectedCurrency, exchangeRates, currencySymbols) %></span>
                                    </div>
                                    <div>
                                        <strong>Статус</strong>
                                        <span class="status-badge status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>"><%= order.status %></span>
                                    </div>
                                </div>
                                <% if (order.items && order.items.length > 0) { %>
                                    <div class="order-items-preview">
                                        <strong>Замовлені вироби:</strong>
                                        <ul>
                                            <% order.items.forEach(item => { %>
                                                <li>
                                                    <span><a href="/product/<%= item.productId %>"><%= item.name %></a> × <%= item.quantity %> шт.</span>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-orders-box">
                        <p>У вас ще немає замовлень.</p>
                        <a href="/catalog" class="btn btn-secondary btn-sm">Перейти до каталогу</a>
                    </div>
                <% } %>
            </section>

            <section class="profile-actions">
                <a href="/logout" class="btn btn-outline-danger"><i class="fa-solid fa-right-from-bracket" style="margin-right: 8px; margin-left: 0;"></i> Вийти з акаунту</a>
            </section>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/dist/main.bundle.js" defer></script>
    <script src="/js/password-validation.js" defer></script> 
</body>
</html>