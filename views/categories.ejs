<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Наші Категорії | Вузлик до вузлика</title>
    <% if (typeof metaDescription !== 'undefined') { %>
    <meta name="description" content="<%= metaDescription %>">
<% } %>
    
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preload" href="/fonts/roboto-v47-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-v29-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin>
    
    <link rel="stylesheet" href="/css/common.css">
    
    <link rel="preload" href="/css/categories.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/css/categories.css"></noscript>
    
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
    
    <style>
        @media (min-width: 768px) {
            .categories-grid.items-1,
            .categories-grid.items-2 {
                display: flex;
                justify-content: center;
                gap: 40px;
            }
            .categories-grid.items-1 .category-item {
                width: 100%;
                max-width: 450px;
            }
            .categories-grid.items-2 .category-item {
                width: 100%;
                max-width: 400px;
            }
        }
        
        .cat-subtitle {
            color: #4A4A4A !important;
        }

        .category-item-content h2.category-card-title {
            font-size: 2.2rem;
            font-weight: 800;
            font-family: 'Montserrat', sans-serif;
            color: #FFFFFF;
            margin: 0;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
            transition: transform 0.4s ease;
        }
        .category-item:hover .category-item-content h2.category-card-title {
            transform: translateY(-5px);
        }
        @media (max-width: 768px) {
            .category-item-content h2.category-card-title { font-size: 1.8rem; }
        }
    </style>
</head>
<body class="categories-page-body apple-minimal-theme">
    <%- include('partials/header') %>

    <main class="categories-main">
        <div class="cat-ambient-bg">
            <div class="cat-blob cat-blob-1"></div>
            <div class="cat-blob cat-blob-2"></div>
        </div>

        <div class="container cat-container">
            
            <header class="cat-header" data-aos="fade-down">
                <h1 class="cat-title text-gradient">Наші Категорії</h1>
                <p class="cat-subtitle">Оберіть розділ, щоб знайти ідеальну вишивку чи аксесуар для себе або на подарунок</p>
            </header>

            <section class="categories-section">
                <% 
                    let gridModifier = '';
                    if (typeof categories !== 'undefined') {
                        if (categories.length === 1) gridModifier = 'items-1';
                        else if (categories.length === 2) gridModifier = 'items-2';
                    }
                %>
                <div class="categories-grid <%= gridModifier %>">
                    
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach((category, index) => { %>
                            <a href="/catalog?category=<%= category.slug %>" class="category-item glass-panel" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                                <div class="category-image-wrap">
                                    <%
                                        let catImgSrc = '/images/placeholder.png';
                                        if (typeof category.image === 'string') {
                                            catImgSrc = category.image;
                                        } else if (category.image && category.image.url) {
                                            catImgSrc = category.image.url;
                                        }
                                    %>
                                    <img src="<%= catImgSrc %>" 
                                         alt="<%= category.name %>" 
                                         loading="<%= index === 0 ? 'eager' : 'lazy' %>" 
                                         fetchpriority="<%= index === 0 ? 'high' : 'auto' %>">

                                    <div class="image-overlay-gradient"></div>
                                </div>
                                <div class="category-item-content">
                                    <h2 class="category-card-title"><%= category.name %></h2>
                                    <div class="category-explore-btn">
                                        Перейти до каталогу <i class="fa-solid fa-arrow-right"></i>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <div class="cat-empty-state glass-panel" data-aos="fade-up">
                            <i class="fa-solid fa-layer-group"></i>
                            <h2>Категорії формуються</h2>
                            <p>Ми саме зараз оновлюємо наші колекції. Загляньте сюди трохи згодом або перейдіть до загального каталогу.</p>
                            <a href="/catalog?category=all" class="cat-btn-primary">Дивитись усі товари</a>
                        </div>
                    <% } %>

                </div>
            </section>

        </div>
    </main>

    <%- include('partials/footer') %>
    
    <link rel="preload" href="https://unpkg.com/aos@next/dist/aos.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" /></noscript>
    
    <script src="https://unpkg.com/aos@next/dist/aos.js" defer></script>
    <script src="/dist/main.bundle.js" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, duration: 800, easing: 'ease-out-cubic', offset: 50 });
            }

            const a11yIframeInterval = setInterval(() => {
                const merchantIframe = document.getElementById('merchantwidgetiframe');
                if (merchantIframe && !merchantIframe.hasAttribute('title')) {
                    merchantIframe.setAttribute('title', 'Віджет зв\'язку з магазином');
                    clearInterval(a11yIframeInterval);
                }
            }, 1000);
            setTimeout(() => clearInterval(a11yIframeInterval), 15000);

            const sideMenu = document.getElementById('side-menu-panel');
            if (sideMenu) {
                const manageMenuFocus = () => {
                    const isHidden = sideMenu.getAttribute('aria-hidden') === 'true';
                    const focusableElements = sideMenu.querySelectorAll('a, button, input, [tabindex]:not([tabindex="-1"])');
                    
                    focusableElements.forEach(el => {
                        if (isHidden) {
                            el.setAttribute('tabindex', '-1');
                            el.setAttribute('aria-disabled', 'true');
                        } else {
                            el.removeAttribute('tabindex');
                            el.removeAttribute('aria-disabled');
                        }
                    });
                };

                manageMenuFocus();

                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        if (mutation.attributeName === 'aria-hidden') {
                            manageMenuFocus();
                        }
                    });
                });
                observer.observe(sideMenu, { attributes: true });
            }
        });
    </script>
</body>
</html>