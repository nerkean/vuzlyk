<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Наші категорії | Вузлик до вузлика</title>
    <% if (typeof metaDescription !== 'undefined') { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } %>
    
    <link rel="icon" type="image/png" href="/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preload" href="/fonts/roboto-v47-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-v29-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin>
    
    <link rel="stylesheet" href="/css/common.css?v=<%= appVersion %>">
    <link rel="stylesheet" href="/css/categories.css?v=<%= appVersion %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
</head>
<body class="categories-page-body">
    <%- include('partials/header') %>

    <main class="categories-main">
        <div class="cat-ambient-bg">
            <div class="cat-blob cat-blob-1"></div>
            <div class="cat-blob cat-blob-2"></div>
        </div>

        <div class="container cat-container">
            <header class="cat-header" data-aos="fade-down">
                <span class="section-eyebrow">Колекції ручної роботи</span>
                <h1 class="section-title">Наші категорії</h1>
                <p class="cat-subtitle">Оберіть розділ каталогу, щоб знайти ідеальну вишивку чи аксесуар ручної роботи для себе або на подарунок</p>
            </header>

            <section class="categories-section">
                <% 
                    const displayCategories = (typeof categories !== 'undefined' && categories.length > 0) ? categories : [
                        { name: 'Вишиті картини', slug: 'vyshyti-kartyny', image: '/images/placeholder.svg' },
                        { name: 'Авторський одяг', slug: 'avtorskyi-odiah', image: '/images/placeholder.svg' },
                        { name: 'Шопери та сумки', slug: 'shopery-ta-sumky', image: '/images/placeholder.svg' },
                        { name: 'Вишиті прикраси', slug: 'vyshyti-prykrasy', image: '/images/placeholder.svg' },
                        { name: 'Текстиль для дому', slug: 'tekstyl-dlia-domu', image: '/images/placeholder.svg' },
                        { name: 'Закладки для книг', slug: 'zakladky-dlia-knyh', image: '/images/placeholder.svg' }
                    ];
                    let gridModifier = '';
                    if (displayCategories.length === 1) gridModifier = 'items-1';
                    else if (displayCategories.length === 2) gridModifier = 'items-2';
                %>
                <div class="categories-grid <%= gridModifier %>">
                    <% displayCategories.forEach((category, index) => { %>
                        <a href="/catalog?category=<%= category.slug %>" class="category-item glass-panel" data-aos="fade-up" data-aos-delay="<%= (index % 3) * 80 %>">
                            <div class="category-image-wrap">
                                <%
                                    let catImgSrc = '/images/placeholder.svg';
                                    if (typeof category.image === 'string') {
                                        catImgSrc = category.image;
                                    } else if (category.image && category.image.url) {
                                        catImgSrc = category.image.url;
                                    }
                                %>
                                <img src="<%= catImgSrc %>" 
                                     alt="<%= category.name %>" 
                                     loading="<%= index < 3 ? 'eager' : 'lazy' %>" 
                                     fetchpriority="<%= index === 0 ? 'high' : 'auto' %>"
                                     onerror="this.onerror=null; this.src='/images/placeholder.svg';">

                                <div class="image-overlay-gradient"></div>
                            </div>
                            <div class="category-item-content">
                                <span class="category-num">0<%= index + 1 %></span>
                                <h2 class="category-card-title"><%= category.name %></h2>
                                <div class="category-explore-btn">
                                    Перейти до розділу <i class="fa-solid fa-arrow-right"></i>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>

                <div class="text-center" style="margin-top: 55px;" data-aos="fade-up">
                    <a href="/catalog?category=all" class="btn btn-primary btn-lg">Переглянути всі вироби разом <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>
    
    <script src="https://unpkg.com/aos@next/dist/aos.js" defer></script>
    <script src="/dist/main.bundle.js?v=<%= appVersion %>" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, duration: 750, easing: 'ease-out-cubic', offset: 50 });
            }
        });
    </script>
</body>
</html>