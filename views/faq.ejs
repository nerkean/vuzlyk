    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <% if (locals.isProduction && locals.gaMeasurementId) { %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= locals.gaMeasurementId %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-17036727455');
        gtag('config', '<%= locals.gaMeasurementId %>');
      </script>
    <% } %>

    <link rel="preload" href="/fonts/montserrat-v29-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/roboto-v47-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/faq-page.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" integrity="sha512-xh6O/CkQoPOWDdYTDqeRdPCVd1SpvCA9XXcUnZS2FmJNp1coAFzvtCN9BmamE+4aHK8yyUHUSCcJHgXloTyT2A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<script type="application/ld+json">
<%
  const _pageTitle = typeof pageTitle !== 'undefined' ? pageTitle : "Часті питання (FAQ) - Вузлик до вузлика";
  const _pageDescription = typeof pageDescription !== 'undefined' ? pageDescription : "Відповіді на часті питання про вишивку, замовлення, доставку та догляд за виробами від майстерні Вузлик до вузлика.";
  const _canonicalUrl = typeof canonicalUrl !== 'undefined' ? canonicalUrl : ( (typeof baseUrl === 'string' ? baseUrl : 'https://vuzlyk.com') + '/faq');
  const _baseUrl = typeof baseUrl === 'string' ? baseUrl : 'https://vuzlyk.com';

  const faqPageMainEntity = [];

  const faqItems = [
    {
      question: "Як зробити замовлення?",
      answerHtml: "<p>Оберіть позицію з нашого <a href='/catalog'>каталогу</a>, вкажіть ваші побажання щодо дизайну, розміру та кольорів. Залиште контактні дані, і ми незабаром зв’яжемося з вами, щоб обговорити деталі та підтвердити замовлення.</p>"
    },
    {
      question: "Який термін виконання замовлення?",
      answerHtml: "<p>Термін виконання залежить від складності та обсягу вашого замовлення. Зазвичай це займає від 3 до 5 робочих днів. Ми обов'язково повідомимо вам точний час після отримання замовлення.</p>"
    },
    {
      question: "Які способи оплати доступні?",
      answerHtml: "<p>Після виконання вашого замовлення ми надішлемо реквізити для оплати на рахунок ФОП.</p>"
    },
    {
      question: "Як я можу отримати замовлення?",
      answerHtml: "<p>Ми відправляємо замовлення через Нову Пошту чи Укрпоштою. Ви можете вибрати зручний для вас спосіб доставки під час оформлення замовлення.</p>"
    },
    {
      question: "Чи можна замовити вишивку за індивідуальним дизайном?",
      answerHtml: "<p>Так, ми приймаємо замовлення за індивідуальним дизайном. <a href='mailto:info@vuzlyk.com'>Напишіть нам</a> свої побажання або надайте ескіз, і ми створимо для вас унікальну вишивку, що відповідає вашим вимогам.</p>"
    },
    {
      question: "Чи можна змінити кольори вишивки?",
      answerHtml: "<p>Так, ви можете вказати бажані кольори в замовленні, і ми адаптуємо дизайн під ваші уподобання.</p>"
    },
    {
      question: "Чи можна замовити подарункову упаковку?",
      answerHtml: "<p>Так, ми можемо упакувати ваше замовлення в подарункову упаковку за додаткову плату. Виберіть цю опцію під час оформлення замовлення.</p>"
    },
    {
      question: "Чи є знижки на оптові замовлення?",
      answerHtml: "<p>Так, ми пропонуємо знижки на оптові замовлення. <a href='mailto:info@vuzlyk.com'>Зв'яжіться з нами</a> для отримання деталей та індивідуальної пропозиції.</p>"
    },
    {
      question: "Чи можна замовити вишивку для команди або корпоративних заходів?",
      answerHtml: "<p>Так, ми створюємо вишивки для корпоративних клієнтів та команд. <a href='mailto:info@vuzlyk.com'>Зв'яжіться з нами</a> для отримання деталей та індивідуальної пропозиції.</p>"
    },
    {
      question: "Як доглядати за виробами ручної вишивки?",
      answerHtml: "<p>Рекомендуємо ручне прання у прохолодній воді з м'яким миючим засобом. Уникайте сильного тертя та віджиму. Прасуйте виріб з виворітного боку через тонку тканину.</p>"
    },
    {
      question: "Моє питання не тут, як з вами зв'язатися?",
      answerHtml: "<p>Якщо ви не знайшли відповідь на своє питання, будь ласка, <a href='/contacts'>зв'яжіться з нами</a> або зателефонуйте за номером +380 63 284 03 21. Ми будемо раді допомогти!</p>"
    }
  ];

  faqItems.forEach(item => {
    faqPageMainEntity.push({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answerHtml 
      }
    });
  });

  const graph = [
    {
      "@type": "WebPage",
      "@id": _canonicalUrl,
      "url": _canonicalUrl,
      "name": _pageTitle,
      "description": _pageDescription,
      "inLanguage": "uk",
      "isPartOf": {
        "@type": "WebSite",
        "@id": _baseUrl + "/#website",
        "url": _baseUrl + "/",
        "name": "Вузлик до вузлика",
        "publisher": { "@id": _baseUrl + "/#organization" }
      },
      "breadcrumb": { "@id": _canonicalUrl + "#breadcrumb" },
      "mainEntity": { "@id": _canonicalUrl + "#faqlist" } 
    },
    {
      "@type": "BreadcrumbList",
      "@id": _canonicalUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Головна", "item": _baseUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": "Часті питання (FAQ)", "item": _canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": _canonicalUrl + "#faqlist", 
      "mainEntity": faqPageMainEntity 
    }
  ];
%>
<%- JSON.stringify({ "@context": "https://schema.org", "@graph": graph }, null, 0) %>
</script>
</head>
<body>
    <%- include('partials/header', { cartItemCount: typeof cartItemCount !== 'undefined' ? cartItemCount : 0 }) %>

    <main class="faq-page-main section-padding">
        <div class="container">
            <div class="text-center">
                <span class="section-eyebrow">Допомога та інформація</span>
                <h1 class="section-title">Часті питання (FAQ)</h1>
            </div>

            <div class="faq-list">
