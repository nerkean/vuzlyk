    <script src="/dist/main.bundle.js?v=<%= appVersion %>" defer></script>
    <script src="https://unpkg.com/aos@next/dist/aos.js" defer></script>
    <script src="https://unpkg.com/zdog@1/dist/zdog.dist.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof AOS !== 'undefined') {
            AOS.init({
                once: true,
                duration: 750,
                easing: 'ease-out-cubic',
                offset: 50
            });
        }

        if (typeof Zdog !== 'undefined') {
            const zdogCanvas = document.getElementById('zdog-hero-canvas');
            if (zdogCanvas) {
                let illo = new Zdog.Illustration({
                    element: zdogCanvas, zoom: 1.2, dragRotate: true, resize: 'fullscreen',
                });
                const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#B88E65';
                const accentDarkColor = getComputedStyle(document.documentElement).getPropertyValue('--color-accent-dark').trim() || '#8C6643';
                const accentLightColor = getComputedStyle(document.documentElement).getPropertyValue('--color-accent-light').trim() || '#E6D2B5';
                let knotGroup = new Zdog.Group({ addTo: illo, translate: { y: -10 } });
                new Zdog.Ellipse({ addTo: knotGroup, diameter: 70, stroke: 12, color: accentColor });
                new Zdog.Shape({
                    addTo: knotGroup, path: [ { x: -35, y: 0 }, { bezier: [ { x: -55, y: 0 }, { x: -45, y: -30 }, { x: -25, y: -35 } ] }, { bezier: [ { x: 0, y: -40 }, { x: 25, y: -35 }, { x: 0, y: -15 } ] }, { bezier: [ { x: -25, y: 5 }, { x: -45, y: 30 }, { x: -35, y: 0 } ] }, ],
                    closed: false, stroke: 6, color: accentDarkColor, rotate: { z: Zdog.TAU/8 }
                });
                new Zdog.Shape({
                    addTo: knotGroup, path: [ { x: 35, y: 0 }, { bezier: [ { x: 55, y: 0 }, { x: 45, y: 30 }, { x: 25, y: 35 } ] }, { bezier: [ { x: 0, y: 40 }, { x: -25, y: 35 }, { x: 0, y: 15 } ] }, { bezier: [ { x: 25, y: -5 }, { x: 45, y: -30 }, { x: 35, y: 0 } ] }, ],
                    closed: false, stroke: 6, color: accentLightColor, rotate: { z: -Zdog.TAU/8 }
                });
                let t = 0;
                function animateZdog() {
                    knotGroup.rotate.y += 0.003;
                    knotGroup.rotate.x = Math.sin(t * 0.05) * 0.2;
                    t++;
                    illo.updateRenderGraph();
                    requestAnimationFrame(animateZdog);
                }
                animateZdog();
                window.addEventListener('resize', () => { illo.setSize(zdogCanvas.offsetWidth, zdogCanvas.offsetHeight); });
                illo.setSize(zdogCanvas.offsetWidth, zdogCanvas.offsetHeight);
            }
        }

        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            gsap.registerPlugin(ScrollTrigger);

            const processSection = document.querySelector('.creation-process-scrollytelling');
            if (processSection) {
                const progressFill = processSection.querySelector('.progress-line-fill');
                const stepNavItems = gsap.utils.toArray('.process-steps-nav .step-nav-item');
                const stepContents = gsap.utils.toArray('.process-content-panel .process-step-content');

                if (progressFill) {
                    ScrollTrigger.create({
                        trigger: processSection,
                        start: "top center",
                        end: "bottom center",
                        scrub: true,
                        onUpdate: self => {
                            gsap.to(progressFill, { height: (self.progress * 100) + '%', ease: "none", duration: 0.1 });
                        }
                    });
                }

                function updateNav(activeIndex) {
                    stepNavItems.forEach((nav, i) => {
                        if (i === activeIndex) {
                            nav.classList.add('fully-active', 'active');
                        } else if (i < activeIndex) {
                            nav.classList.remove('fully-active');
                            nav.classList.add('active');
                        } else {
                            nav.classList.remove('fully-active', 'active');
                        }
                    });
                }

                stepContents.forEach((content, index) => {
                    ScrollTrigger.create({
                        trigger: content,
                        start: "top center+=150",
                        end: "bottom center+=150", 
                        onEnter: () => updateNav(index),
                        onEnterBack: () => updateNav(index)
                    });
                });
            }
        }
    });
    </script>
</body>
</html>