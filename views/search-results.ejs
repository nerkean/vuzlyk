<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Результати пошуку: "<%= query %>" | Вузлик до вузлика</title>
    <meta name="robots" content="noindex, follow">

    <link rel="icon" type="image/png" href="/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preload" href="/fonts/roboto-v47-cyrillic_latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/montserrat-v29-cyrillic_latin-700.woff2" as="font" type="font/woff2" crossorigin>
    
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/search-results.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
</head>
<body class="search-page-body">
    <%- include('partials/header') %>

    <main class="search-page-main">
        <div class="container sr-container">

            <header class="sr-header" data-aos="fade-down">
                <span class="section-eyebrow">Пошук по майстерні</span>
                <h1 class="sr-title">Результати пошуку</h1>
                
                <form action="/search" method="GET" class="sr-inline-search-form">
                    <input type="search" name="q" value="<%= query %>" placeholder="Введіть назву вишивки або тему..." required>
                    <button type="submit" class="btn btn-primary">Знайти <i class="fa-solid fa-magnifying-glass"></i></button>
                </form>

                <div class="sr-meta-row">
                    <span class="sr-query-info">Запит: <strong class="sr-query-highlight">«<%= query %>»</strong></span>
                    <span class="sr-total-badge">
                        Знайдено збігів: <span class="sr-count"><%= (typeof products !== 'undefined' ? products.length : 0) + (typeof posts !== 'undefined' ? posts.length : 0) %></span>
                    </span>
                </div>
            </header>

            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                <section class="sr-section" data-aos="fade-up">
                    <h2 class="sr-section-title">Вироби в каталозі <span class="badge"><%= products.length %></span></h2>
                    
                    <div class="sr-grid products-grid">
                        <% products.forEach(product => { %>
                            <article class="sr-card product-card">
                                <a href="/product/<%= product._id %>" class="sr-card-link">
                                    <div class="sr-card-image-wrap">
                                        <% 
                                            let imgSrc = '/images/placeholder.svg';
                                            if (product.images && product.images.length > 0) {
                                                const imgSet = product.images[0];
                                                if (imgSet.medium && imgSet.medium.url) imgSrc = imgSet.medium.url;
                                                else if (imgSet.large && imgSet.large.url) imgSrc = imgSet.large.url;
                                                else if (imgSet.thumb && imgSet.thumb.url) imgSrc = imgSet.thumb.url;
                                            }
                                        %>
                                        <img src="<%= imgSrc %>" alt="<%= product.name %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.svg';">
                                        
                                        <% if (product.status === 'В наявності') { %>
                                            <span class="sr-status-badge instock">В наявності</span>
                                        <% } else if (product.status === 'Під замовлення') { %>
                                            <span class="sr-status-badge preorder">Під замовлення</span>
                                        <% } %>
                                    </div>
                                    <div class="sr-card-content">
                                        <% if (product.category) { %>
                                            <div class="sr-card-category"><%= product.category %></div>
                                        <% } %>
                                        <h3 class="sr-card-title"><%= product.name %></h3>
                                        <div class="sr-card-price">
                                            <% if (product.price !== undefined) { %>
                                                <%= typeof formatPrice !== 'undefined' ? formatPrice(product.price, selectedCurrency, exchangeRates, currencySymbols) : product.price + ' ₴' %>
                                            <% } else { %>
                                                Ціну уточнюйте
                                            <% } %>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    </div>
                </section>
            <% } %>

            <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
                <section class="sr-section" data-aos="fade-up" data-aos-delay="100">
                    <h2 class="sr-section-title">Статті в блозі <span class="badge"><%= posts.length %></span></h2>
                    
                    <div class="sr-grid blog-grid">
                        <% posts.forEach(post => { %>
                            <article class="sr-card blog-card">
                                <a href="/blog/<%= post.slug %>" class="sr-card-link">
                                    <div class="sr-card-image-wrap">
                                        <% 
                                            let postImg = post.imageUrl || (post.image && post.image.url) || '/images/placeholder.svg';
                                        %>
                                        <img src="<%= postImg %>" alt="<%= post.title %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.svg';">
                                    </div>
                                    <div class="sr-card-content">
                                        <div class="sr-card-meta">
                                            <% if (post.publishedAt || post.createdAt) { %>
                                                <span><i class="fa-regular fa-calendar"></i> <%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('uk-UA') %></span>
                                            <% } %>
                                        </div>
                                        <h3 class="sr-card-title"><%= post.title %></h3>
                                        <% const postText = post.summary || post.excerpt || ''; %>
                                        <% if (postText) { %>
                                            <p class="sr-card-excerpt"><%= postText.length > 115 ? postText.substring(0, 115) + '...' : postText %></p>
                                        <% } %>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    </div>
                </section>
            <% } %>

            <% if ((!products || products.length === 0) && (!posts || posts.length === 0)) { %>
                <div class="sr-empty-state" data-aos="zoom-in">
                    <div class="sr-empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                    <h2>Нічого не знайдено</h2>
                    <p>На жаль, за запитом <strong class="sr-query-highlight">«<%= query %>»</strong> ми не знайшли жодного виробу чи статті.</p>
                    <p class="sr-empty-hint">Спробуйте змінити ключове слово або перегляньте всі наші роботи в каталозі.</p>
                    <a href="/catalog" class="btn btn-primary btn-lg">Перейти в каталог <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>
    
    <script src="https://unpkg.com/aos@next/dist/aos.js" defer></script>
    <script src="/dist/main.bundle.js" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, duration: 700, easing: 'ease-out-cubic', offset: 50 });
            }
        });
    </script>
</body>
</html>